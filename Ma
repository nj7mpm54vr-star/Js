local antiBait = {
    enabled = false, detectRadius = 60,
    detectCommit = true, commitDot = 0.85, commitDist = 80,
    dodgeDist = 60, dodgeCooldown = 0.05,
    evadeBait = true, stallThreshold = 0.15, notify = false,
}
local abConns = {}
local abLast = 0

local function abDodge(fromPos)
    if not root then return end
    local now = tick()
    if now - abLast < antiBait.dodgeCooldown then return end
    abLast = now
    local away = root.Position - fromPos
    if away.Magnitude < 0.01 then away = Vector3.new(1,0,0) end
    away = away.Unit
    local perp = Vector3.new(-away.Z, 0, away.X)
    local dir = (away * 0.6 + perp * (math.random() < 0.5 and -0.4 or 0.4)).Unit
    root.CFrame = root.CFrame + dir * antiBait.dodgeDist
    if antiBait.notify then Notify("Anti-Bait dodge", 1) end
end

function startAntiBait()
    stopAntiBait()
    antiBait.enabled = true
    abConns.loop = RunService.Heartbeat:Connect(function()
        if not antiBait.enabled or not root then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and h and h.Health > 0 then
                    local delta = hrp.Position - root.Position
                    local dist = delta.Magnitude
                    if dist < antiBait.detectRadius then
                        if antiBait.detectCommit then
                            if hrp.CFrame.LookVector:Dot((-delta).Unit) > antiBait.commitDot and dist < antiBait.commitDist then
                                abDodge(hrp.Position)
                            end
                        end
                        if antiBait.evadeBait and hrp.AssemblyLinearVelocity.Magnitude < antiBait.stallThreshold and dist < antiBait.detectRadius * 0.5 then
                            abDodge(hrp.Position)
                        end
                    end
                end
            end
        end
    end)
end

function stopAntiBait()
