            vsLastAnchorPos = vsApplyOrbitCombo(vsPoint(i))
            if voidSpam.jitter then vsLastAnchorPos = vsLastAnchorPos + Vector3.new(rand(-1,1), rand(-1,1), rand(-1,1)) * voidSpam.jitterAmp end
            if voidSpam.clampY then vsLastAnchorPos = Vector3.new(vsLastAnchorPos.X, math.clamp(vsLastAnchorPos.Y, -voidSpam.clampYAbs, voidSpam.clampYAbs), vsLastAnchorPos.Z) end
        end
        vsAnchorFrame = (vsAnchorFrame + 1) % math.max(1, voidSpam.anchorFrames)
        if vsLastAnchorPos then hrp.CFrame = CFrame.new(vsLastAnchorPos) end
    elseif mode == "Rebound" then
        local box = voidSpam.reboundBox
        if not vsReboundPos then
            vsReboundPos = vsPoint(i)
            vsReboundDir = Vector3.new(rand(-1,1), rand(-1,1), rand(-1,1)).Unit
        end
        vsReboundPos = vsReboundPos + (vsReboundDir or Vector3.new(1,0,0)) * (box * 0.05)
        if math.abs(vsReboundPos.X) > box then vsReboundDir = Vector3.new(-vsReboundDir.X, vsReboundDir.Y, vsReboundDir.Z) end
        if math.abs(vsReboundPos.Y) > box then vsReboundDir = Vector3.new(vsReboundDir.X, -vsReboundDir.Y, vsReboundDir.Z) end
        if math.abs(vsReboundPos.Z) > box then vsReboundDir = Vector3.new(vsReboundDir.X, vsReboundDir.Y, -vsReboundDir.Z) end
        target = vsApplyOrbitCombo(vsReboundPos)
        if voidSpam.clampY then target = Vector3.new(target.X, math.clamp(target.Y, -voidSpam.clampYAbs, voidSpam.clampYAbs), target.Z) end
        hrp.CFrame = CFrame.new(target)
    elseif mode == "Interp" then
        if not vsInterpStart or now - vsInterpStartT > voidSpam.interpTime then
            vsInterpStart = vsPoint(i)
            vsInterpEnd = vsPoint(i + 1)
            vsInterpStartT = now
        end
        local alpha = math.clamp((now - vsInterpStartT) / math.max(0.001, voidSpam.interpTime), 0, 1)
        target = vsInterpStart:Lerp(vsInterpEnd, alpha)
        if voidSpam.clampY then target = Vector3.new(target.X, math.clamp(target.Y, -voidSpam.clampYAbs, voidSpam.clampYAbs), target.Z) end
        hrp.CFrame = CFrame.new(target)
    elseif mode == "Silent" then
        local real = hrp.CFrame
        local fake = vsApplyOrbitCombo(vsPoint(i))
        hrp.CFrame = CFrame.new(fake)
        task.defer(function()
            if root and root.Parent then root.CFrame = real end
        end)
    end
end

