-- ================ orbit (expanded) ================
local orbit = {
    enabled = false, target = "Closest", mode = "Circle",
    speed = 90, radius = 8, height = 0, lerp = 0.3,
    reverse = false, face = true, axis = "XZ",
    offX = 0, offY = 0, offZ = 0, yawOff = 0, pitchOff = 0,
    predictive = false, lead = 0.2,
    randomRadius = false, rMin = 5, rMax = 20,
    speedPulse = false, speedPulseAmp = 0.5, speedPulseHz = 1,
    heightOsc = false, heightOscAmp = 5, heightOscHz = 2,
    distPulse = false, distPulseAmp = 4, distPulseHz = 1,
    zigAmp = 3, zigHz = 4,
    lissA = 3, lissB = 2, lissDelta = math.pi/2,
    spiralGrow = 0.5, helixPitch = 1.5,
    pendulumAmp = 45, pendulumHz = 1,
    dual = false,
    dualBlend = 0.4,
    easing = "smooth",
    autoScale = false,
    autoScaleMult = 0.02,
    velocityInject = false,
    velocityInjectMag = 150,
    randomHeightPerRev = false,
    randomHeightRange = 20,
    lockFacingToVel = false,
}
local orbitConns = {}
local orbitT = 0
local orbitLastRev = 0
local orbitCurHeight = 0
local orbitCurTarget = nil

local function orbitCandidates()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then table.insert(list, {player=p, root=r}) end
        end
    end
    return list
end

local function orbitSortPick(list, mode)
    if #list == 0 then return nil end
    if mode == "Random" then return list[math.random(1,#list)] end
    if mode == "Mouse" then return list[1] end
    local myPos = root and root.Position or Vector3.zero
    local best, bestD
    for _, e in ipairs(list) do
        local d = (e.root.Position - myPos).Magnitude
        if mode == "Closest" then
            if not bestD or d < bestD then best=e; bestD=d end
        elseif mode == "Farthest" then
            if not bestD or d > bestD then best=e; bestD=d end
        end
    end
    return best
end

local function orbitPick()
    return orbitSortPick(orbitCandidates(), orbit.target)
end

local function orbitPickSecondary(primary)
    local list = orbitCandidates()
    local filtered = {}
    for _, e in ipairs(list) do
        if not primary or e.player ~= primary.player then table.insert(filtered, e) end
    end
    return orbitSortPick(filtered, orbit.target)
end

local function easeValue(alpha)
    local e = orbit.easing
    if e == "linear" then return alpha
    elseif e == "sine" then return math.sin(alpha * math.pi * 0.5)
    else return alpha * alpha * (3 - 2 * alpha) end
end

local function orbitOffset(t, targetSpeed)
    local spd = math.rad(orbit.speed) * (orbit.reverse and -1 or 1)
    local r = orbit.radius
    if orbit.randomRadius then r = rand(orbit.rMin, orbit.rMax) end
    if orbit.speedPulse then spd = spd * (1 + math.sin(t*orbit.speedPulseHz*2*math.pi)*orbit.speedPulseAmp) end
    if orbit.distPulse then r = r + math.sin(t*orbit.distPulseHz*2*math.pi)*orbit.distPulseAmp end
    if orbit.autoScale then r = r + (targetSpeed or 0) * orbit.autoScaleMult end

    local h = orbit.height
    if orbit.heightOsc then h = h + math.sin(t*orbit.heightOscHz*2*math.pi)*orbit.heightOscAmp end
    local a = t * spd

    local rev = math.floor(a / (2 * math.pi))
    if orbit.randomHeightPerRev and rev ~= orbitLastRev then
        orbitLastRev = rev
        orbitCurHeight = rand(-orbit.randomHeightRange, orbit.randomHeightRange)
    end
    if orbit.randomHeightPerRev then h = h + orbitCurHeight end

    local m = orbit.mode
    if m == "Circle" then return Vector3.new(math.cos(a)*r, h, math.sin(a)*r)
    elseif m == "Figure8" then return Vector3.new(math.sin(a)*r, h, math.sin(a)*math.cos(a)*r)
    elseif m == "Spiral" then
        local gr = r + t*orbit.spiralGrow
        return Vector3.new(math.cos(a)*gr, h+math.sin(a*0.5)*2, math.sin(a)*gr)
    elseif m == "Lissajous" then
        return Vector3.new(math.sin(orbit.lissA*a)*r, h, math.sin(orbit.lissB*a+orbit.lissDelta)*r)
    elseif m == "Pendulum" then
        local ang = math.sin(a*orbit.pendulumHz)*math.rad(orbit.pendulumAmp)
        return Vector3.new(math.sin(ang)*r, h-math.cos(ang)*r*0.1, math.cos(ang)*r)
    elseif m == "Zigzag" then
        local zz = math.sin(t*orbit.zigHz*2*math.pi)*orbit.zigAmp
        return Vector3.new(math.cos(a)*r, h+zz, math.sin(a)*r)
    elseif m == "Helix" then
        local hy = h + math.sin(a)*orbit.helixPitch*r*0.3 + (a/(2*math.pi))*orbit.helixPitch
        return Vector3.new(math.cos(a)*r, hy, math.sin(a)*r)
    end
    return Vector3.new(math.cos(a)*r, h, math.sin(a)*r)
end

local function applyAxis(v)
    if orbit.axis == "XY" then return Vector3.new(v.X, v.Z, v.Y) end
    if orbit.axis == "YZ" then return Vector3.new(v.Z, v.X, v.Y) end
    return v
end

function startOrbit()
    stopOrbit()
    orbit.enabled = true
    orbitT = 0
    orbitLastRev = 0
    orbitCurHeight = 0
    orbitConns.loop = RunService.RenderStepped:Connect(function(dt)
        if not orbit.enabled or not root then return end
        orbitT = orbitT + dt

        local primary = orbitPick()
        if not primary then return end
        orbitCurTarget = primary

        local tgtPos = primary.root.Position
        if orbit.predictive then tgtPos = tgtPos + primary.root.AssemblyLinearVelocity * orbit.lead end

        if orbit.dual then
            local secondary = orbitPickSecondary(primary)
            if secondary then
                local sPos = secondary.root.Position
                if orbit.predictive then sPos = sPos + secondary.root.AssemblyLinearVelocity * orbit.lead end
                tgtPos = tgtPos:Lerp(sPos, math.clamp(orbit.dualBlend, 0, 1))
            end
        end

        local targetSpeed = primary.root.AssemblyLinearVelocity.Magnitude
        local off = applyAxis(orbitOffset(orbitT, targetSpeed))
        off = off + Vector3.new(orbit.offX, orbit.offY, orbit.offZ)
        local want = tgtPos + off

        local raw = root.Position:Lerp(want, math.clamp(orbit.lerp, 0, 1))
        local eased = root.Position:Lerp(raw, easeValue(math.clamp(orbit.lerp, 0, 1)))

        local cf = CFrame.new(eased)
        if orbit.face then
            if orbit.lockFacingToVel and primary.root.AssemblyLinearVelocity.Magnitude > 1 then
                local look = eased + primary.root.AssemblyLinearVelocity.Unit * 10
                cf = CFrame.lookAt(eased, look)
            else
                cf = CFrame.lookAt(eased, tgtPos)
            end
            cf = cf * CFrame.Angles(math.rad(orbit.pitchOff), math.rad(orbit.yawOff), 0)
        end
        root.CFrame = cf

        if orbit.velocityInject then
            local dir = (want - root.Position)
            if dir.Magnitude > 0.01 then
                root.AssemblyLinearVelocity = dir.Unit * orbit.velocityInjectMag
            end
        end
    end)
end

function stopOrbit()
    orbit.enabled = false
    orbitCurTarget = nil
    for k, c in pairs(orbitConns) do pcall(function() c:Disconnect() end); orbitConns[k] = nil end
end

