    value.TextSize = 12; value.TextXAlignment = Enum.TextXAlignment.Right; value.ZIndex = 3; value.Parent = row
    coordLabels[def.key] = value
end

local dragging, dragStart, startPos = false, nil, nil
card.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = card.Position
    end
end)
card.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - dragStart
        card.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

local pulseT = 0
RunService.Heartbeat:Connect(function(dt)
    if not coordsGui.Enabled then return end
    pulseT = pulseT + dt * 2.2
    local p = (math.sin(pulseT) + 1) * 0.5
    liveDot.BackgroundColor3 = Color3.fromRGB(math.floor(90+p*50), math.floor(200+p*40), math.floor(130+p*40))
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        coordLabels.X.Text = string.format("%.1f", hrp.Position.X)
        coordLabels.Y.Text = string.format("%.1f", hrp.Position.Y)
        coordLabels.Z.Text = string.format("%.1f", hrp.Position.Z)
    else
        coordLabels.X.Text = "—"; coordLabels.Y.Text = "—"; coordLabels.Z.Text = "—"
    end
end)

-- ================ character tracking ================
local function onChar(c)
    char = c
    hum = c:WaitForChild("Humanoid")
    root = c:WaitForChild("HumanoidRootPart")
    if voidSpam.enabled then pcall(startVoidSpam) end
    if vsHelper.enabled then pcall(startVSHelper) end
    if orbit.enabled then pcall(startOrbit) end
    if bait.enabled then pcall(startBait) end
    if antiBait.enabled then pcall(startAntiBait) end
    if freezeBait.enabled then pcall(startFreezeBait) end
    if predict.enabled then pcall(startPredict) end
    if antiAim.enabled then pcall(startAntiAim) end
end
if LocalPlayer.Character then onChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(onChar)
LocalPlayer.CharacterRemoving:Connect(function()
    pcall(stopVoidSpam); pcall(stopVSHelper); pcall(stopOrbit)
    pcall(stopBait); pcall(stopAntiBait); pcall(stopFreezeBait); pcall(stopPredict)
    pcall(stopAntiAim)
    char, root, hum = nil, nil, nil
end)

