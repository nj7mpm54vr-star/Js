local function vsPoint(i)
    local a = voidSpam.amplitude
    local m = voidSpam.method
    local base = Vector3.new(voidSpam.offsetX, voidSpam.offsetY, voidSpam.offsetZ)
    local p
    if m == "Quantum" then
        p = Vector3.new(rand(-a,a)*voidSpam.spreadX, rand(voidSpam.yMin, voidSpam.yMax)*voidSpam.spreadY, rand(-a,a)*voidSpam.spreadZ)
    elseif m == "Scatter" then
        p = Vector3.new(rand(-a,a), rand(voidSpam.yMin, voidSpam.yMax), rand(-a,a))
    elseif m == "Grid" then
        local s, e = voidSpam.gridStep, voidSpam.gridExtent
        p = Vector3.new(math.random(-e,e)*s, math.random(-e,e)*s, math.random(-e,e)*s)
    elseif m == "Sphere" then
        local phi = math.random() * math.pi * 2
        local theta = math.acos(2 * math.random() - 1)
        local r = voidSpam.radius
        p = Vector3.new(r*math.sin(theta)*math.cos(phi), r*math.cos(theta), r*math.sin(theta)*math.sin(phi))
    elseif m == "Chaos" then
        local t = tick()*5 + i
        p = Vector3.new(math.sin(t*3.1)*a, math.cos(t*7.3)*math.min(a, voidSpam.yMax), math.sin(t*5.7)*a)
    elseif m == "Line" then
        local ang = math.rad(voidSpam.lineAngle)
        local s = rand(-voidSpam.lineLen, voidSpam.lineLen)
        p = Vector3.new(math.cos(ang)*s, 0, math.sin(ang)*s)
    elseif m == "Fibonacci" then
        local n = voidSpam.fibCount
        local idx = i % n
        local gr = (1 + math.sqrt(5)) / 2
        local theta = 2 * math.pi * idx / gr
        local phi = math.acos(1 - 2 * (idx + 0.5) / n)
        local r = voidSpam.radius
        p = Vector3.new(r*math.sin(phi)*math.cos(theta), r*math.cos(phi), r*math.sin(phi)*math.sin(theta))
    elseif m == "Helix" then
        local t = i * 0.05
        p = Vector3.new(math.cos(t)*a*0.5, math.sin(t*2)*voidSpam.yMax*0.5, math.sin(t)*a*0.5)
    elseif m == "DualBand" then
        local band = (i % 2 == 0) and voidSpam.yMax or voidSpam.yMin
        p = Vector3.new(rand(-a,a), band, rand(-a,a))
    end
    if not p then p = Vector3.zero end
    if not voidSpam.axisX then p = Vector3.new(0, p.Y, p.Z) end
    if not voidSpam.axisY then p = Vector3.new(p.X, 0, p.Z) end
    if not voidSpam.axisZ then p = Vector3.new(p.X, p.Y, 0) end
    return base + p
end

local function vsApplyOrbitCombo(p)
    if not voidSpam.orbitCombo then return p end
    local a = tick() * math.rad(voidSpam.orbitComboSpeed)
    return p + Vector3.new(math.cos(a), 0, math.sin(a)) * voidSpam.orbitComboRadius
end

local function vsRecordCorrection(newPos)
    if vsLastRealPos and (newPos - vsLastRealPos).Magnitude > voidSpam.amplitude * 0.5 then
        table.insert(vsCorrectionTimes, tick())
    end
    vsLastRealPos = newPos
    local now = tick()
    while #vsCorrectionTimes > 0 and now - vsCorrectionTimes[1] > voidSpam.lockoutWindow do
        table.remove(vsCorrectionTimes, 1)
    end
    if voidSpam.detectLockout and #vsCorrectionTimes > voidSpam.lockoutThreshold and not vsLockedOut then
        vsLockedOut = true
        Notify("Void lockout: server correcting too frequently", 3)
        task.delay(voidSpam.lockoutWindow, function() vsLockedOut = false end)
    end
end

