-- ================ fast melee ================
local fastMelee = {
    enabled = false, patchMelee = true, patchGuns = true,
    cooldown = 0.001, snapshot = nil,
}
local gunExceptions = { Sniper = true, Crossbow = true, Bow = true, RPG = true }
local MELEE_PROPS = {"AttackCooldown","SwingCooldown","MeleeCooldown","Cooldown","RecoveryTime","ResetTime"}
local GUN_PROPS   = {"ShootSpread","ShootAccuracy","ShootRecoil","ShootCooldown","ShootBurstCooldown"}

local function getItems()
    if game.GameId ~= 6035872082 then return nil end
    local ok, lib = pcall(function()
        return require(game:GetService("ReplicatedStorage").Modules.ItemLibrary)
    end)
    if ok and lib and lib.Items then return lib.Items end
    return nil
end

local function fastMeleeApply()
    local items = getItems()
    if not items then Notify("Fast Melee: item library not found", 3); return false end
    if not fastMelee.snapshot then
        local snap = {}
        for name, data in pairs(items) do
            if typeof(data) == "table" then
                local entry = {}
                for _, p in ipairs(MELEE_PROPS) do if data[p] ~= nil then entry[p] = data[p] end end
                for _, p in ipairs(GUN_PROPS) do if data[p] ~= nil then entry[p] = data[p] end end
                if next(entry) then snap[name] = entry end
            end
        end
        fastMelee.snapshot = snap
    end
    local cd = fastMelee.cooldown
    for name, data in pairs(items) do
        if typeof(data) == "table" then
            if fastMelee.patchMelee then
                for _, p in ipairs(MELEE_PROPS) do if data[p] ~= nil then data[p] = cd end end
            end
            if fastMelee.patchGuns and not gunExceptions[name] then
                if data.ShootSpread then data.ShootSpread = 0 end
                if data.ShootAccuracy then data.ShootAccuracy = 0 end
                if data.ShootRecoil then data.ShootRecoil = 0 end
                if data.ShootCooldown then data.ShootCooldown = cd end
                if data.ShootBurstCooldown then data.ShootBurstCooldown = cd end
            end
        end
    end
    Notify("Fast Melee applied", 2)
    return true
end

local function fastMeleeRevert()
    local items = getItems()
    if not items or not fastMelee.snapshot then return false end
    for name, props in pairs(fastMelee.snapshot) do
        local data = items[name]
        if typeof(data) == "table" then
            for p, v in pairs(props) do pcall(function() data[p] = v end) end
        end
    end
    fastMelee.snapshot = nil
    Notify("Fast Melee reverted", 2)
    return true
end

