local bait = {
    enabled = false, mode = "Stall",
    stallTime = 0.08, stallChance = 0.4, fakeLockTime = 0.06,
    pulseHz = 4, pulseFreezeTime = 0.03, freezeTime = 0.05, snapDistance = 40,
    lureMove = 6, lureHold = 0.15,
    notifyLabel = true, autoEvade = true, evadeTrigger = "Attack",
    evadeDist = 25, evadeCooldown = 0.4, evadePower = 80,
}
local baitConns = {}
local baitLastEvade = 0

local function baitEvade()
    if not root then return end
    local now = tick()
    if now - baitLastEvade < bait.evadeCooldown then return end
    baitLastEvade = now
    local dirs = {Vector3.new(1,0,0), Vector3.new(-1,0,0), Vector3.new(0,0,1), Vector3.new(0,0,-1), Vector3.new(1,0,1).Unit, Vector3.new(-1,0,-1).Unit}
    root.CFrame = root.CFrame + dirs[math.random(1, #dirs)] * bait.evadePower
    if bait.notifyLabel then Notify("BAIT → EVADE", 1) end
end

local function baitLoop()
    if not bait.enabled or not root then return end
    local mode = bait.mode
    if mode == "Stall" then
        if math.random() < bait.stallChance then task.wait(bait.stallTime) end
    elseif mode == "FakeLock" then
        local old = root.CFrame
        task.wait(bait.fakeLockTime)
        if root and root.Parent then root.CFrame = old end
    elseif mode == "Pulse" then
        task.wait(1 / math.max(1, bait.pulseHz))
        if root and root.Parent then
            local h = root.CFrame
            task.wait(bait.pulseFreezeTime)
            if root and root.Parent then root.CFrame = h end
        end
    elseif mode == "FreezeSnap" then
        local h = root.CFrame
        task.wait(bait.freezeTime)
        if root and root.Parent then
            root.CFrame = h + Vector3.new(math.random(-bait.snapDistance, bait.snapDistance), 0, math.random(-bait.snapDistance, bait.snapDistance))
        end
    elseif mode == "Lure" then
        root.CFrame = root.CFrame + root.CFrame.LookVector * bait.lureMove
        task.wait(bait.lureHold)
    end
end

function startBait()
    stopBait()
    bait.enabled = true
    baitConns.loop = task.spawn(function()
        while bait.enabled do pcall(baitLoop); task.wait(0.05) end
    end)
    if bait.autoEvade then
        baitConns.evade = RunService.Heartbeat:Connect(function()
            if not bait.enabled or not root then return end
            if bait.evadeTrigger == "Proximity" or bait.evadeTrigger == "Both" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local h = p.Character:FindFirstChildOfClass("Humanoid")
                        if hrp and h and h.Health > 0 and (hrp.Position - root.Position).Magnitude < bait.evadeDist then
                            baitEvade(); break
                        end
                    end
                end
            end
        end)
    end
end

function stopBait()
    bait.enabled = false
    for k, c in pairs(baitConns) do
        if typeof(c) == "RBXScriptConnection" then pcall(function() c:Disconnect() end) end
        if typeof(c) == "thread" then pcall(task.cancel, c) end
        baitConns[k] = nil
    end
end

