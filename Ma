-- ================ prediction ================
local predict = {
    enabled = false, method = "Trajectory",
    detectTpEnabled = true, tpThreshold = 30, tpWindow = 0.4,
    voidDetectEnabled = true, voidProxThreshold = 15, voidVelocitySpike = 200,
    detectAccel = true, accelThreshold = 500,
    dodgeDist = 40, dodgeCooldown = 0.06, dodgeRange = 80,
    predictLead = 0.15, reactiveLayers = 3, layerGap = 0.02,
    randomizeDir = true, preferPerpendicular = true,
    verticalSpike = true, verticalSpikeAmp = 15,
    notify = false, ignoreBait = true, stallThreshold = 2.0,
    priorityMode = "Closest",
    threatScoreEnabled = true, threatScoreRange = 120,
    aimVectorDetect = true, multithreaded = true,
    predictTable = {}, lastDodge = 0, lastNotify = 0,
}
local predictLastPos = {}

local function recFor(plr, hrp)
    local rec = predict.predictTable[plr]
    if not rec then
        rec = { history = {}, lastVel = Vector3.zero, lastPos = hrp.Position, lastTick = tick() }
        predict.predictTable[plr] = rec
    end
    return rec
end

local function pushHistory(plr, hrp)
    local rec = recFor(plr, hrp)
    local now = tick()
    table.insert(rec.history, { pos = hrp.Position, t = now })
    while #rec.history > 0 and now - rec.history[1].t > predict.tpWindow do
        table.remove(rec.history, 1)
    end
    rec.lastPos = hrp.Position
    rec.lastVel = hrp.AssemblyLinearVelocity
    rec.lastTick = now
end

local function scoreThreat(hrp)
    if not root then return 0 end
    local delta = hrp.Position - root.Position
    local dist = delta.Magnitude
    if dist > predict.threatScoreRange then return 0 end
    local score = (1 - dist / predict.threatScoreRange) * 50
    score = score + math.min(hrp.AssemblyLinearVelocity.Magnitude / 5, 30)
    if predict.aimVectorDetect then
        local dot = hrp.CFrame.LookVector:Dot((-delta).Unit)
        if dot > 0.85 then score = score + 20 end
    end
    return score
end

local function execDodge(hrp, reason)
    if not root then return end
    local now = tick()
    if now - predict.lastDodge < predict.dodgeCooldown then return end
    predict.lastDodge = now
    local method = predict.method
    local dist = predict.dodgeDist
    local pushVec
    if method == "RadialBurst" then
        local away = root.Position - hrp.Position
        if away.Magnitude < 0.01 then away = Vector3.new(1,0,0) end
        pushVec = away.Unit * dist
    elseif method == "PredictiveOrbit" then
        local future = hrp.Position + hrp.AssemblyLinearVelocity * predict.predictLead
        local away = root.Position - future
        if away.Magnitude < 0.01 then away = Vector3.new(1,0,0) end
        local perp = Vector3.new(-away.Z, 0, away.X)
        pushVec = (away.Unit * 0.4 + perp * 0.9).Unit * dist
    elseif method == "Slingshot" then
        local fwd = hrp.CFrame.LookVector
        local side = Vector3.new(-fwd.Z, 0, fwd.X)
        local sign = math.random() < 0.5 and -1 or 1
        pushVec = side * sign * dist + fwd * (dist * 0.3)
    elseif method == "CounterDive" then
        local away = root.Position - hrp.Position
        if away.Magnitude < 0.01 then away = Vector3.new(1,0,0) end
        pushVec = away.Unit * dist * 0.5 + Vector3.new(0, -dist * 0.4, 0)
    elseif method == "Random" then
        local a = math.random() * math.pi * 2
        pushVec = Vector3.new(math.cos(a), math.random(-0.3, 0.3), math.sin(a)).Unit * dist
    elseif method == "Silent" then
        pushVec = CFrame.new(hrp.Position, root.Position).LookVector * -dist
    elseif method == "Layered" then
        task.spawn(function()
            for i = 1, predict.reactiveLayers do
                if not root then break end
                local a = math.random() * math.pi * 2
                local d = Vector3.new(math.cos(a), 0, math.sin(a)) * (dist * (0.7 + i * 0.2))
                root.CFrame = root.CFrame + d
                task.wait(predict.layerGap)
            end
        end)
        return
    else
        local away = root.Position - hrp.Position
        if away.Magnitude < 0.01 then away = Vector3.new(1,0,0) end
        pushVec = away.Unit * dist
    end
    if predict.verticalSpike then
        pushVec = pushVec + Vector3.new(0, math.random(-1,1) * predict.verticalSpikeAmp, 0)
    end
    root.CFrame = root.CFrame + pushVec
    if predict.notify then
        local n = tick()
        if n - predict.lastNotify > 0.3 then
            predict.lastNotify = n
            Notify("Dodge: " .. reason, 1)
        end
    end
end

local function predictTick()
    if not predict.enabled or not root then return end
    local threats = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and h and h.Health > 0 then
                pushHistory(p, hrp)
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= predict.dodgeRange then
                    local score = predict.threatScoreEnabled and scoreThreat(hrp) or (predict.dodgeRange - dist)
                    local prev = predictLastPos[p]
                    predictLastPos[p] = hrp.Position
                    local jumped = prev and (hrp.Position - prev).Magnitude
                    if predict.detectTpEnabled and jumped and jumped > predict.tpThreshold then
                        table.insert(threats, { player = p, hrp = hrp, score = score + 100, reason = "TP" })
                    elseif predict.voidDetectEnabled then
                        if hrp.AssemblyLinearVelocity.Magnitude > predict.voidVelocitySpike and dist < predict.voidProxThreshold * 3 then
                            table.insert(threats, { player = p, hrp = hrp, score = score + 80, reason = "VoidSpam" })
                        end
                    end
                    if predict.detectAccel then
                        local rec = predict.predictTable[p]
                        if rec then
                            local dv = (hrp.AssemblyLinearVelocity - rec.lastVel).Magnitude
                            if dv > predict.accelThreshold and dist < predict.dodgeRange * 0.6 then
                                table.insert(threats, { player = p, hrp = hrp, score = score + 60, reason = "Accel" })
                            end
                        end
                    end
                    if predict.ignoreBait then
                        if hrp.AssemblyLinearVelocity.Magnitude >= predict.stallThreshold or dist >= predict.dodgeRange * 0.5 then
                            table.insert(threats, { player = p, hrp = hrp, score = score, reason = "Proximity" })
                        end
                    else
                        table.insert(threats, { player = p, hrp = hrp, score = score, reason = "Proximity" })
                    end
                end
            end
        end
    end
    if #threats == 0 then return end
    if predict.priorityMode == "Fastest" then
        table.sort(threats, function(a, b) return a.hrp.AssemblyLinearVelocity.Magnitude > b.hrp.AssemblyLinearVelocity.Magnitude end)
    elseif predict.priorityMode == "Random" then
        local pick = threats[math.random(1, #threats)]
        execDodge(pick.hrp, pick.reason)
        return
    else
        table.sort(threats, function(a, b) return a.score > b.score end)
    end
    local top = threats[1]
    if top then execDodge(top.hrp, top.reason) end
end

function startPredict()
    stopPredict()
    predict.enabled = true
    predict.lastDodge = 0
    predict.lastNotify = 0
    predictLastPos = {}
    predict.predictTable = {}
    local evt = predict.multithreaded and RunService.Heartbeat or RunService.Stepped
    predict._conn = evt:Connect(function() pcall(predictTick) end)
end

function stopPredict()
    predict.enabled = false
    if predict._conn then pcall(function() predict._conn:Disconnect() end); predict._conn = nil end
end

-- ================ anti-aim ================
local antiAim = {
    enabled = false, mode = "Spin", speed = 3000, jitter = 45,
    pitchLock = false, rollBot = false, rollSpeed = 360,
}
local aaConn

local function aaTick()
    if not antiAim.enabled or not root then return end
    local now = tick()
    local t = now * antiAim.speed
    local yaw, pitch, roll = 0, 0, 0
    local m = antiAim.mode
    if m == "Spin" then
        yaw = t % 360
    elseif m == "Jitter" then
        yaw = math.sin(now * antiAim.speed) * antiAim.jitter
        pitch = math.cos(now * antiAim.speed * 0.7) * antiAim.jitter * 0.5
    elseif m == "Random" then
        if math.random() < 0.3 then
            yaw = math.random(-180, 180)
            pitch = math.random(-60, 60)
        end
    elseif m == "Static" then
        yaw = 180
    elseif m == "Desync" then
        yaw = math.sin(now * antiAim.speed) * 180
        pitch = math.cos(now * antiAim.speed * 0.5) * 45
    end
    if antiAim.pitchLock then pitch = -90 end
    if antiAim.rollBot then roll = (now * antiAim.rollSpeed) % 360 end
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(pitch), math.rad(yaw), math.rad(roll))
end

function startAntiAim()
    stopAntiAim()
    antiAim.enabled = true
    aaConn = RunService.RenderStepped:Connect(function() pcall(aaTick) end)
end

function stopAntiAim()
    antiAim.enabled = false
    if aaConn then pcall(function() aaConn:Disconnect() end); aaConn = nil end
end

