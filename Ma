    attackDetectRange = 30, jitterDuring = false, jitterAmp = 5,
}
local fbConns = {}
local fbActive = false

local function fbTick()
    if not freezeBait.enabled or not root then return end
    if freezeBait.onAttackOnly then
        local attacked = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - root.Position).Magnitude < freezeBait.attackDetectRange and hrp.CFrame.LookVector:Dot((root.Position - hrp.Position).Unit) > 0.8 then
                    attacked = true; break
                end
            end
        end
        if not attacked then return end
    end
    if fbActive then return end
    fbActive = true
    local frozen = root.CFrame
    if freezeBait.jitterDuring then
        local startT = tick()
        while tick() - startT < freezeBait.freezeTime do
            if not root or not freezeBait.enabled then break end
            root.CFrame = frozen + Vector3.new(math.random(-freezeBait.jitterAmp, freezeBait.jitterAmp), 0, math.random(-freezeBait.jitterAmp, freezeBait.jitterAmp))
            RunService.Heartbeat:Wait()
        end
    elseif freezeBait.lockCFrame then
        local lockConn = RunService.Heartbeat:Connect(function()
            if root and freezeBait.enabled then root.CFrame = frozen end
        end)
        task.wait(freezeBait.freezeTime)
        lockConn:Disconnect()
    else
        task.wait(freezeBait.freezeTime)
    end
    if root then
        local off = freezeBait.randomDir
            and Vector3.new(math.random(-freezeBait.snapDist, freezeBait.snapDist), math.random(-freezeBait.snapVertical, freezeBait.snapVertical), math.random(-freezeBait.snapDist, freezeBait.snapDist))
